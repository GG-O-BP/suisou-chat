{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.ggobp.suisou-chat.e2e",
  "build": {
    "beforeBuildCommand": "env -u NO_COLOR trunk build --release --dist dist-e2e",
    "frontendDist": "../dist-e2e"
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "description": "Test-only capability for the embedded WebDriver server",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:event:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
